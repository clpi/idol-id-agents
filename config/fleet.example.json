{
  "mode": "observe-plan",
  "repository": "~/x/idol",
  "state_dir": "~/.local/state/idol-fleet",
  "work_orders_dir": "~/.local/state/idol-fleet/work-orders",
  "calibration_file": "~/.local/state/idol-fleet/calibration.json",
  "interval_seconds": 60,
  "max_assignments": 2,
  "claim_ttl_seconds": 3600,
  "witness_timeout_seconds": 1800,
  "base_branch": "main",
  "author_name": "idol-fleet-agent",
  "author_email": "noreply@idol.id",
  "auto_calibrate": false,
  "calibration_ttl_seconds": 21600,
  "repository_claim_required": true,
  "max_consecutive_cycle_failures": 5,
  "routes": [
    {
      "id": "ollama-local-observer",
      "provider": "ollama",
      "model": "qwen3-coder:30b",
      "provider_family": "qwen",
      "runtime": "openclaw",
      "command": [
        "openclaw",
        "agent",
        "exec",
        "--message-file",
        "{prompt}",
        "--cwd",
        "{cwd}",
        "--model",
        "{model}",
        "--json",
        "--timeout",
        "900"
      ],
      "parser": "openclaw-json",
      "billing": "local",
      "proof": {
        "kind": "local-process",
        "subject_hash": "",
        "observed_at": 0,
        "expires_at": 0,
        "evidence_hash": "",
        "trusted": false
      },
      "roles": ["observer", "counterexample", "evidence", "mechanic"],
      "auth_env": [],
      "timeout_seconds": 900,
      "max_parallel": 2,
      "premium": false,
      "enabled": false,
      "allowance": [],
      "proof_command": ["ollama", "list"],
      "proof_expect": "(?m)^qwen3-coder:30b\\s"
    },
    {
      "id": "codex-subscription",
      "provider": "openai-codex",
      "model": "gpt-5.6-codex",
      "provider_family": "openai",
      "runtime": "openclaw",
      "command": [
        "openclaw",
        "agent",
        "exec",
        "--message-file",
        "{prompt}",
        "--cwd",
        "{cwd}",
        "--model",
        "{model}",
        "--json",
        "--timeout",
        "1800"
      ],
      "parser": "openclaw-json",
      "billing": "included",
      "proof": {
        "kind": "subscription-oauth",
        "subject_hash": "",
        "observed_at": 0,
        "expires_at": 0,
        "evidence_hash": "",
        "trusted": false
      },
      "roles": ["architect", "implementer", "reviewer"],
      "auth_env": [],
      "timeout_seconds": 1800,
      "max_parallel": 1,
      "premium": true,
      "enabled": false,
      "allowance": [],
      "proof_command": ["codex", "login", "status"],
      "proof_expect": "(?i)(chatgpt|subscription|logged in)"
    },
    {
      "id": "hermes-subscription",
      "provider": "anthropic",
      "model": "claude-opus-5",
      "provider_family": "anthropic",
      "runtime": "hermes",
      "command": [
        "hermes",
        "--model",
        "{model}",
        "--usage-file",
        "{usage}",
        "-z",
        "{prompt_text}"
      ],
      "parser": "hermes-usage",
      "billing": "included",
      "proof": {
        "kind": "subscription-oauth",
        "subject_hash": "",
        "observed_at": 0,
        "expires_at": 0,
        "evidence_hash": "",
        "trusted": false
      },
      "roles": ["architect", "implementer", "reviewer", "counterexample"],
      "auth_env": [],
      "timeout_seconds": 1800,
      "max_parallel": 1,
      "premium": true,
      "enabled": false,
      "allowance": [],
      "proof_command": ["hermes", "auth", "status"],
      "proof_expect": "(?i)(anthropic|claude).*(oauth|subscription|logged in)"
    }
  ]
}
