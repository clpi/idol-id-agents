# Copy to ~/.config/idol-health-probe.env and replace paths/names for r16.
# systemd EnvironmentFile values do not expand ~ or shell variables.
PYTHONPATH=/home/REPLACE_ME/REPLACE_WITH_CONTROLLER_ROOT
IDOL_HEALTH_STATE_DIR=/home/REPLACE_ME/.local/state/idol-health-probe
IDOL_HEALTH_HEARTBEAT=/home/REPLACE_ME/.config/idol-hermes/primary-heartbeat
IDOL_HEALTH_ROLE=/home/REPLACE_ME/.config/idol-hermes/role
IDOL_HEALTH_HEARTBEAT_MAX_AGE=55
IDOL_HEALTH_IDOL_CONFIG=/home/REPLACE_ME/REPLACE_WITH_IDOL_FLEET_CONFIG.json
IDOL_HEALTH_LIVE_CONFIG=/home/REPLACE_ME/REPLACE_WITH_LIVE_FLEET_CONFIG.json
IDOL_HEALTH_IDOL_JOURNAL=/home/REPLACE_ME/.local/state/idol-fleet-idol/fleet-history.jsonl
IDOL_HEALTH_LIVE_JOURNAL=/home/REPLACE_ME/.local/state/idol-fleet-live/fleet-history.jsonl
IDOL_HEALTH_MM_NAMES=mm,mac-mini,macmini
